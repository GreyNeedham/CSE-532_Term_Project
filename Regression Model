import pandas as pd
import matplotlib.pyplot as plt
from sklearn.linear_model import LinearRegression
import numpy as np

# Load data
df = pd.read_csv("Entity,Code,Year,Annual CO₂ emissions.txt", sep=",")
df.columns = ["Entity", "Code", "Year", "Emissions"]

# Use only numeric rows
df = df.dropna(subset=["Year", "Emissions"])

X = df["Year"].values.reshape(-1, 1)
y = df["Emissions"].values

model = LinearRegression()
model.fit(X, y)

# Predictions
y_pred = model.predict(X)

plt.figure(figsize=(10,6))
plt.scatter(df["Year"], df["Emissions"], alpha=0.3, s=10)
plt.plot(df["Year"], y_pred, color="red", linewidth=2)
plt.title("Linear Regression: CO₂ Emissions Over Time")
plt.xlabel("Year")
plt.ylabel("Emissions (tonnes)")
plt.tight_layout()
plt.show()
